{
	"name": "neokeys",
	"version": "0.1.1",
	"description": "Neovim-inspired leader keys and sequential keybindings for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
