		"@types/node": "^22.10.2",
		"esbuild": "^0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.5.0",
		"jest": "^30.0.0",
		"obsidian": "^1.14.4",
		"ts-jest": "^29.2.5",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"yaml": "^2.9.1"
	}
